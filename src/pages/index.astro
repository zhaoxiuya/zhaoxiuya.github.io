---
import DefaultLayout from "../layouts/default.astro";
---

<DefaultLayout title="Home">
    <div class="container">
        <header><h1>Hello!</h1></header>
        <nav class="tabs">
            <button class="tab-btn is-active" type="button" data-tab="main"
                >About Me</button
            >
            <button class="tab-btn" type="button" data-tab="interests"
                >Interests</button
            >
            <button class="tab-btn" type="button" data-tab="etc">Other</button>
            <button class="tab-btn" type="button" data-tab="contact"
                >Contact</button
            >
        </nav>

        <div class="content-wrapper">
            <div id="main" class="content-section active">
                <h2>About Me</h2>
                <p>
                    Hello! I'm Sua Tso, a second-year student at Korea Digital
                    Media High School majoring in web programming. I speak
                    Korean and English. I'm interested in compiler theory,
                    computer vision, category theory, and competitive
                    programming. I'm currently the President of the <a
                        href="https://github.com/monadimi">Monad Club</a
                    >.
                </p>
            </div>
            <div id="etc" class="content-section">
                <img
                    class="photo"
                    src="src/images/me.webp"
                    alt="프로필 사진"
                    loading="lazy"
                    decoding="async"
                />
                <pre
                    class="code-block">
zhaoxiuya :: <span class="tok-h">Person</span>
zhaoxiuya = <span class="tok-h">Person</span>
&#123; name        = <span class="tok-h">"Sua Tso"</span>
, birthYear   = 2009
, location    = <span class="tok-h">"South Korea"</span>
, languages   = [<span class="tok-h">"Korean"</span>, <span class="tok-h">"English"</span>]
, highSchool  = <span class="tok-h">"KDMHS"</span>
, major       = <span class="tok-h">"Web Programming"</span>
, email       = <span class="tok-h">"zhaoxiuya13@gmail.com"</span>
, bio         = unlines
    [ <span class="tok-h">"CS Student Interested in PLT and"</span>
    , <span class="tok-h">"Category Theory. I enjoy making useless"</span>
    , <span class="tok-h">"things and sleeping in the dorm"</span>
    ]
&#125;
                </pre>
            </div>
            <div id="interests" class="content-section">
                <h2>Programming Languages</h2>
                <p>Haskell, C, C++, Fortran, Python, Zig</p>
                <br />
                <h2>Computer Science</h2>
